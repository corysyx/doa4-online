+bool D3D12Presenter::InitializePostFx() {
+  if (post_fx_init_tried_) return post_fx_pipeline_ != nullptr;
+  post_fx_init_tried_ = true;
+  HMODULE compiler = LoadLibraryW(L"D3DCompiler_47.dll");  // kept loaded: the blobs come from it
+  using D3DCompileFn = HRESULT(WINAPI*)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO*, ID3DInclude*, LPCSTR,
+                                        LPCSTR, UINT, UINT, ID3DBlob**, ID3DBlob**);
+  auto compile = compiler ? reinterpret_cast<D3DCompileFn>(GetProcAddress(compiler, "D3DCompile")) : nullptr;
+  if (!compile) {
+    REXLOG_ERROR("D3D12Presenter: picture effects unavailable: D3DCompiler_47.dll or D3DCompile not found");
+    return false;
+  }
+  Microsoft::WRL::ComPtr<ID3DBlob> vs, ps, errors;
+  constexpr UINT kOptimizationLevel3 = 1u << 15;  // D3DCOMPILE_OPTIMIZATION_LEVEL3
+  for (int stage = 0; stage < 2; ++stage) {
+    errors.Reset();
+    HRESULT hr = compile(kPostFxHlsl, sizeof(kPostFxHlsl) - 1, "rex_post_fx", nullptr, nullptr, stage ? "ps" : "vs",
+                         stage ? "ps_5_0" : "vs_5_0", kOptimizationLevel3, 0,
+                         stage ? ps.ReleaseAndGetAddressOf() : vs.ReleaseAndGetAddressOf(),
+                         errors.ReleaseAndGetAddressOf());
+    if (FAILED(hr)) {
+      REXLOG_ERROR("D3D12Presenter: picture effects unavailable: the {} shader did not compile: {}",
+                   stage ? "pixel" : "vertex",
+                   errors ? std::string(static_cast<const char*>(errors->GetBufferPointer()), errors->GetBufferSize())
+                          : std::string("(no message)"));
+      return false;
+    }
+  }
+  D3D12_DESCRIPTOR_RANGE range = {};
+  range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  range.NumDescriptors = 1;
+  range.BaseShaderRegister = 0;
+  range.RegisterSpace = 0;
+  range.OffsetInDescriptorsFromTableStart = 0;
+  D3D12_ROOT_PARAMETER params[2] = {};
+  params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+  params[0].DescriptorTable.NumDescriptorRanges = 1;
+  params[0].DescriptorTable.pDescriptorRanges = &range;
+  params[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+  params[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  params[1].Constants.ShaderRegister = 0;
+  params[1].Constants.RegisterSpace = 0;
+  params[1].Constants.Num32BitValues = kPostFxValues + 4;
+  params[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+  D3D12_STATIC_SAMPLER_DESC sampler = {};
+  sampler.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+  sampler.AddressU = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+  sampler.AddressV = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+  sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+  sampler.MaxAnisotropy = 1;
+  sampler.ComparisonFunc = D3D12_COMPARISON_FUNC_NEVER;
+  sampler.BorderColor = D3D12_STATIC_BORDER_COLOR_OPAQUE_BLACK;
+  sampler.MinLOD = 0.0f;
+  sampler.MaxLOD = 0.0f;
+  sampler.ShaderRegister = 0;
+  sampler.RegisterSpace = 0;
+  sampler.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+  D3D12_ROOT_SIGNATURE_DESC root_desc = {};
+  root_desc.NumParameters = 2;
+  root_desc.pParameters = params;
+  root_desc.NumStaticSamplers = 1;
+  root_desc.pStaticSamplers = &sampler;
+  root_desc.Flags = D3D12_ROOT_SIGNATURE_FLAG_NONE;
+  ID3D12RootSignature* root_signature = util::CreateRootSignature(provider_, root_desc);
+  if (!root_signature) {
+    REXLOG_ERROR("D3D12Presenter: picture effects unavailable: no root signature");
+    return false;
+  }
+  *post_fx_root_signature_.ReleaseAndGetAddressOf() = root_signature;
+  D3D12_GRAPHICS_PIPELINE_STATE_DESC pipeline_desc = {};
+  pipeline_desc.pRootSignature = root_signature;
+  pipeline_desc.VS.pShaderBytecode = vs->GetBufferPointer();
+  pipeline_desc.VS.BytecodeLength = vs->GetBufferSize();
+  pipeline_desc.PS.pShaderBytecode = ps->GetBufferPointer();
+  pipeline_desc.PS.BytecodeLength = ps->GetBufferSize();
+  pipeline_desc.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+  pipeline_desc.SampleMask = UINT_MAX;
+  pipeline_desc.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+  pipeline_desc.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+  pipeline_desc.RasterizerState.DepthClipEnable = TRUE;
+  pipeline_desc.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+  pipeline_desc.NumRenderTargets = 1;
+  pipeline_desc.RTVFormats[0] = kGuestOutputIntermediateFormat;
+  pipeline_desc.SampleDesc.Count = 1;
+  if (FAILED(provider_.GetDevice()->CreateGraphicsPipelineState(&pipeline_desc,
+                                                                IID_PPV_ARGS(&post_fx_pipeline_)))) {
+    REXLOG_ERROR("D3D12Presenter: picture effects unavailable: no pipeline");
+    post_fx_pipeline_.Reset();
+    return false;
+  }
+  REXLOG_INFO("D3D12Presenter: picture effects ready");
+  return true;
+}
