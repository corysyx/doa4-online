+extern "C" __declspec(dllexport) void rex_post_fx_set(int on, const float* values, int count) {
+  std::lock_guard<std::mutex> lock(g_post_fx_mutex);
+  g_post_fx_on = on != 0 && values && count > 0;
+  for (int i = 0; i < kPostFxValues; ++i) g_post_fx_values[i] = values && i < count ? values[i] : 0.0f;
+}
